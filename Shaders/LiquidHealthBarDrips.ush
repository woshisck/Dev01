// LiquidHealthBarDrips.ush  v1
// Leak layer for the liquid health bar: falling droplets + wet residue stain.
// Lives on its own Image below the tube art so the main bar material stays untouched.
// Animation comes from the material Time node, so C++ never has to tick for drips.
//
// Custom Node call:
//   return LiquidDripsMain(UV, Time, LeakIntensity, LeakX, TubeBottom, DripSize, DripAspect, DripColor, StainColor);
//
// Parameters:
//   UV            - TexCoord[0]
//   Time          - Time node
//   LeakIntensity - ScalarParameter "LeakIntensity" (0-1, driven by C++ from health)
//   LeakX         - ScalarParameter "LeakX" (UV.x the liquid surface sits at; drips originate here)
//   TubeBottom    - ScalarParameter "TubeBottom" (UV.y of the tube's lower edge; drips fall below it)
//   DripSize      - ScalarParameter "DripSize" (droplet radius in UV.y units; ~0.10 to start)
//   DripAspect    - ScalarParameter "DripAspect" (see note below; ~10 for a 420x82 bar)
//   DripColor     - VectorParameter "DripColor" -> ComponentMask(RGB)
//   StainColor    - VectorParameter "StainColor" -> ComponentMask(RGB)
//
// DripAspect note:
//   UV space is not square on a wide widget, so a circle in UV renders as a squashed
//   ellipse. On-screen width/height of a droplet is ImageAspect / DripAspect, where
//   ImageAspect = ImageWidth / ImageHeight. Set DripAspect = ImageAspect for round
//   drops, and 2 * ImageAspect for drops twice as tall as they are wide.
//
// Custom Node setup:
//   Include File Path : /Project/LiquidHealthBarDrips.ush
//   Output Type       : CMOT Float 4
//   float4.rgb -> Emissive Color,  float4.a -> Opacity

// Cheap per-column scalar hash. Deterministic, no texture lookup.
float LHBD_Hash11(float X)
{
    return frac(sin(X * 78.233) * 43758.5453);
}

float4 LiquidDripsMain(
    float2 UV,
    float  Time,
    float  LeakIntensity,
    float  LeakX,
    float  TubeBottom,
    float  DripSize,
    float  DripAspect,
    float3 DripColor,
    float3 StainColor
)
{
    // LeakIntensity is a uniform, so this branch is coherent across the whole draw
    // and costs nothing at full health (the common case).
    if (LeakIntensity <= 0.001)
    {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    // ── 1. Fall region (everything below the tube lip) ──────────────────────
    float below    = step(TubeBottom, UV.y);
    float fallSpan = max(1.0 - TubeBottom, 1e-4);
    float depth    = saturate((UV.y - TubeBottom) / fallSpan);   // 0 at lip, 1 at bottom

    // ── 2. Column assignment ────────────────────────────────────────────────
    //   Each pixel belongs to exactly one column, so cost is O(1) rather than a
    //   loop over every candidate droplet.
    const float ColumnCount = 10.0;
    float colIdx    = floor(UV.x * ColumnCount);
    float colCenter = (colIdx + 0.5) / ColumnCount;
    float colSeed   = LHBD_Hash11(colIdx * 1.7);

    // Columns switch on progressively as the leak worsens.
    float colActive = step(colSeed, LeakIntensity);

    // Only columns near the breach leak at all.
    const float LeakWidth = 0.14;
    float nearLeak = saturate(1.0 - abs(colCenter - LeakX) / LeakWidth);

    // ── 3. Droplets (two staggered per column) ──────────────────────────────
    float speed = lerp(0.55, 0.95, LHBD_Hash11(colIdx * 3.1));
    float drips = 0.0;

    for (int i = 0; i < 2; ++i)
    {
        float phase = frac(Time * speed + colSeed + i * 0.5);

        // Quadratic fall so the droplet accelerates under gravity.
        float dripY = TubeBottom + fallSpan * phase * phase;

        float2 dv = float2(UV.x - colCenter, UV.y - dripY);
        dv.x *= DripAspect;                 // compensate for non-square UV space
        dv.y /= (1.0 + phase * 1.6);        // stretch into a teardrop as it speeds up

        drips += smoothstep(DripSize, 0.0, length(dv)) * (1.0 - phase);
    }

    drips = saturate(drips) * colActive * nearLeak * below;

    // ── 4. Wet residue under the breach ─────────────────────────────────────
    //   Strongest at the lip, fading downward. Squared for a tighter falloff.
    const float StainWidth = 0.20;
    float stainX = saturate(1.0 - abs(UV.x - LeakX) / StainWidth);
    float stain  = stainX * stainX * (1.0 - depth) * below * 0.55;

    // ── 5. Combine ──────────────────────────────────────────────────────────
    float3 col   = DripColor * drips + StainColor * stain;
    float  alpha = saturate(drips + stain) * LeakIntensity;

    return float4(col, alpha);
}
